@Article{Pressman2005,
  author       = {Pressman, Sarah D and Cohen, Sheldon},
  date         = {2005},
  journaltitle = {Psychological bulletin},
  title        = {Does Positive Affect Influence Health?},
  issn         = {0033-2909},
  language     = {eng},
  number       = {6},
  pages        = {925-971},
  volume       = {131},
  abstract     = {This review highlights consistent patterns in the literature associating
positive affect (PA) and physical health. However, it also raises serious
conceptual and methodological reservations. Evidence suggests an association of
trait PA and lower morbidity and of state and trait PA and decreased symptoms
and pain. Trait PA is also associated with increased longevity among older
community-dwelling individuals. The literature on PA and surviving serious
illness is inconsistent. Experimentally inducing intense bouts of activated
state PA triggers short-term rises in physiological arousal and associated
(potentially harmful) effects on immune, cardiovascular, and pulmonary function.
However, arousing effects of state PA are not generally found in naturalistic
ambulatory studies in which bouts of PA are typically less intense and often
associated with health protective responses. A theoretical framework to guide
further study is proposed.},
  copyright    = {2005 American Psychological Association},
  keywords     = {Adaptation, Psychological - physiology ; Adolescent ; Adult ; Affect (Psychology) ; Affect - physiology ; Affective Behavior ; Aged ; Aged, 80 and over ; Arousal - physiology ; Arousal Patterns ; Behavioural psychology ; Biological and medical sciences ; Child ; Community ; Death and Dying ; Disease - psychology ; Emotional States ; Emotions ; Etiology ; Female ; Fundamental and applied biological sciences. Psychology ; Happiness ; Health ; Health care ; Human ; Humans ; Illness ; Life cycles ; Life Expectancy ; Longevity ; Male ; Middle Aged ; Miscellaneous ; Morality ; Morbidity ; Mortality ; Negativism ; Older Adults ; Personality Traits ; Physical Disorders ; Physical fitness ; Physical Health ; Physiological Arousal ; Positive Affect ; Positive and Negative Symptoms ; Positivism ; Psychological research ; Psychology ; Psychology and medicine ; Psychology, Multidisciplinary ; Psychology. Psychoanalysis. Psychiatry ; Psychology. Psychophysiology ; Psychophysiology ; Research Methodology ; Social Sciences ; Survival Analysis ; Survivors ; Theories},
  location     = {WASHINGTON},
  publisher    = {American Psychological Association},
}

@Article{Lyubomirsky2005,
  author       = {Lyubomirsky, Sonja and King, Laura and Diener, Ed},
  date         = {2005},
  journaltitle = {Psychological bulletin},
  title        = {The Benefits of Frequent Positive Affect: Does Happiness Lead to Success?},
  issn         = {0033-2909},
  language     = {eng},
  number       = {6},
  pages        = {803-855},
  volume       = {131},
  abstract     = {Numerous studies show that happy individuals are successful across multiple life domains, including marriage, friendship, income, work performance, and health. The authors suggest a conceptual model to account for these findings, arguing that the happiness-success link exists not only because success makes people happy, but also because positive affect engenders success. Three classes of evidence-cross-sectional, longitudinal, and experimental-are documented to test their model. Relevant studies are described and their effect sizes combined meta-analytically. The results reveal that happiness is associated with and precedes numerous successful outcomes, as well as behaviors paralleling success. Furthermore, the evidence suggests that positive affect-the hallmark of well-being-may be the cause of many of the desirable characteristics, resources, and successes correlated with happiness. Limitations, empirical issues, and important future research questions are discussed.},
  copyright    = {2005 American Psychological Association},
  keywords     = {Adaptation, Psychological - physiology ; Affect - physiology ; Affective Behavior ; Affective Experiences ; Affectivity. Emotion ; Behavioural psychology ; Biological and medical sciences ; Causal Models ; Cross-sectional analysis ; Developmental psychology ; Effect Size ; Emotional States ; Emotions ; Empirical research ; Friends - psychology ; Friendship ; Fundamental and applied biological sciences. Psychology ; Happiness ; Health ; Human ; Humans ; Income ; Job Satisfaction ; Life Satisfaction ; Longitudinal studies ; Marriage ; Marriage - psychology ; Meta Analysis ; Models, Psychological ; Negativism ; Personal Satisfaction ; Personality. Affectivity ; Positive affect ; Positive emotions ; Positive Reinforcement ; Positivism ; Psychological Patterns ; Psychological research ; Psychological Studies ; Psychology ; Psychology, Multidisciplinary ; Psychology. Psychoanalysis. Psychiatry ; Psychology. Psychophysiology ; Quality of Life ; Social Sciences ; Social success ; Subjective well-being ; Subjectivity ; Success ; Time Factors ; Well Being ; Wellbeing},
  location     = {WASHINGTON},
  publisher    = {American Psychological Association},
}

@Article{Kalmijn1999,
  author       = {Kalmijn, Matthijs},
  date         = {1999},
  journaltitle = {Journal of marriage and family},
  title        = {Father Involvement in Childrearing and the Perceived Stability of Marriage},
  issn         = {0022-2445},
  language     = {eng},
  number       = {2},
  pages        = {409-421},
  volume       = {61},
  abstract     = {The central hypothesis of this article, that large investments by fathers in childrearing are associated with high marital stability, is tested against two competing hypotheses about marital stability. The hypotheses are examined using data from a national survey of households in the Netherlands. Investments are measured with retrospective questions about the degree to which fathers were involved in childrearing tasks. Divorce is measured indirectly, with questions about husbands' and wives' perceptions of the stability of their marriage. Multivariate analyses indicate that when fathers are more involved in childrearing, they have a stabler marriage. When indicators of the wife's marital satisfaction are included, however, the effect of the father's involvement disappears. Involved fathers have stabler marriages, not because they have much investment to lose after a possible breakup, but because the wife is happier if the husband is strongly involved with the children.},
  copyright    = {Copyright 1999 National Council on Family Relations},
  keywords     = {Child care ; Child development ; Child rearing ; Childrearing ; Childrearing Practices ; Children ; Divorce ; Families & family life ; Family Stability ; Family Studies ; Father and child ; Fatherhood ; Fathers ; Husbands ; Investment hypothesis ; Marital Satisfaction ; Marital stability ; Marriage ; Men ; Mothers ; Netherlands ; Parent Child Relations ; Parenthood ; Personal relationships ; Sexuality. Marriage. Family relations ; Social research ; Social Sciences ; Sociology ; Sociology of the family. Age groups ; Wives},
  location     = {MINNEAPOLIS},
  publisher    = {National Council on Family Relations},
}

@Article{Gardiner2009,
  author       = {Gardiner, Joseph C. and Luo, Zhehui and Roman, Lee Anne},
  date         = {2009},
  journaltitle = {Statistics in medicine},
  title        = {Fixed effects, random effects and GEE: What are the differences?},
  issn         = {0277-6715},
  language     = {eng},
  number       = {2},
  pages        = {221-239},
  volume       = {28},
  abstract     = {For analyses of longitudinal repeated‐measures data, statistical methods include the random effects model, fixed effects model and the method of generalized estimating equations. We examine the assumptions that underlie these approaches to assessing covariate effects on the mean of a continuous, dichotomous or count outcome. Access to statistical software to implement these models has led to widespread application in numerous disciplines. However, careful consideration should be paid to their critical assumptions to ascertain which model might be appropriate in a given setting. To illustrate similarities and differences that might exist in empirical results, we use a study that assessed depressive symptoms in low‐income pregnant women using a structured instrument with up to five assessments that spanned the pre‐natal and post‐natal periods. Understanding the conceptual differences between the methods is important in their proper application even though empirically they might not differ substantively. The choice of model in specific applications would depend on the relevant questions being addressed, which in turn informs the type of design and data collection that would be relevant. Copyright © 2008 John Wiley & Sons, Ltd.},
  copyright    = {Copyright © 2008 John Wiley & Sons, Ltd.},
  keywords     = {CES-D ; Community Health Workers ; Conditional maximum likelihood ; Data collection ; Depression - physiopathology ; Differences ; Fixed effects ; Generalized linear mixed model ; Hausman test ; Humans ; Life Sciences & Biomedicine ; Likelihood Functions ; Linear mixed model ; Linear Models ; Longitudinal Studies ; Low income groups ; Mathematical & Computational Biology ; Mathematics ; Maximum likelihood method ; Medical Informatics ; Medical statistics ; Medicine, Research & Experimental ; Models, Statistical ; Nurses ; Patient Care Team - statistics & numerical data ; Physical Sciences ; Pregnancy ; Public, Environmental & Occupational Health ; Random Allocation ; Random effects ; Research & Experimental Medicine ; Robust variance ; Science & Technology ; Statistics & Probability ; Studies},
  location     = {Chichester, UK},
  publisher    = {John Wiley & Sons, Ltd},
}

@Article{Diener1999,
  author       = {Diener, E and Suh, EM and Lucas, RE and Smith, HL},
  date         = {1999},
  journaltitle = {Psychological bulletin},
  title        = {Subjective well-being: Three decades of progress},
  issn         = {0033-2909},
  language     = {eng},
  number       = {2},
  pages        = {276-302},
  volume       = {125},
  abstract     = {W. Wilson's (1967) review of the area of subjective well-being (SWB)advanced several conclusions regarding those who report high levels of "happiness." A number of his conclusions have been overturned: youth and modest aspirations no longer are seen as prerequisites of SWB. E. Diener's (1984) review placed greater emphasis on theories that stressed psychological factors. In the current article, the authors review current evidence for Wilson's conclusions and discuss modem theories of SWB that stress dispositional influences, adaptation, goals, and coping strategies. The next steps in the evolution of the field are to comprehend the interaction of psychological factors with life circumstances in producing SWB, to understand the causal pathways leading to happiness, understand the processes underlying adaptation to events, and develop theories that explain why certain variables differentially influence the different components of SWB (life satisfaction, pleasant affect, and unpleasant affect).},
  copyright    = {1999 INIST-CNRS},
  keywords     = {Affectivity. Emotion ; Biological and medical sciences ; Contentment ; Evaluation ; Fundamental and applied biological sciences. Psychology ; Happiness ; Personality. Affectivity ; Progress ; Psychological aspects ; Psychology ; Psychology, Multidisciplinary ; Psychology. Psychoanalysis. Psychiatry ; Psychology. Psychophysiology ; Social Sciences ; Subjective wellbeing},
  location     = {WASHINGTON},
  publisher    = {Amer Psychological Assoc},
}

@Article{Nomaguchi2017,
  author       = {Nomaguchi, Kei and Brown, Susan and Leyman, Tanya M.},
  date         = {2017},
  journaltitle = {Journal of family issues},
  title        = {Fathers’ Participation in Parenting and Maternal Parenting Stress: Variation by Relationship Status},
  issn         = {0192-513X},
  language     = {eng},
  number       = {8},
  pages        = {1132-1156},
  volume       = {38},
  abstract     = {The growing diversity in mother–father relationship status has led to a debate over the role of fathers in parenting. Little is known, however, about how fathers’ participation in parenting is linked to maternal well-being across different mother–father relationship statuses. Using data from the Fragile Families and Child Wellbeing Study (N = 2,062), fixed-effects as well as random-effects regression models show that overall fathers’ engagement with children and sharing in child-related chores are negatively related to maternal parenting stress. Fathers’ cooperative coparenting is negatively related to maternal parenting stress only in the random-effects model, suggesting that the association is driven by selection factors. There is little variation in these associations by mother–father relationship status, once selection factors are controlled for. These findings extend support for the current cultural emphasis on benefits of fathers’ active participation in parenting for mothers and children even after the mother–father relationship dissolved.},
  copyright    = {The Author(s) 2015},
  keywords     = {Analysis ; Behavior ; Childrearing practices ; Children ; Civilization ; Couples ; Culture ; Family ; father involvement ; Fathers ; maternal parenting stress ; mother-father relationship status ; Multiculturalism & pluralism ; package deal ; Parent and child ; Parent participation ; Parent-child relations ; Parents & parenting ; Participation ; Random effects ; Regression analysis ; Social aspects ; Stress ; Well being},
  location     = {Los Angeles, CA},
  publisher    = {SAGE Publications},
}


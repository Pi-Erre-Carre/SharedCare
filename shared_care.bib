  keywords     = {Approximation ; Biological and medical sciences ; Biometrics ; Child ; Children ; Coefficients ; Computerized, statistical medical data processing and models in biomedicine ; Correlations ; Generalized linear model ; Humans ; Linear regression ; Longitudinal data ; Longitudinal Studies ; Medical sciences ; Models, Statistical ; Mothers ; Regression Analysis ; Respiratory diseases ; Respiratory Tract Infections - epidemiology ; Smoking ; Statistical variance},
  location     = {Malden, MA},

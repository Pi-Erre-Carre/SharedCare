@Article{Craig2011,
  author       = {Craig, Lyn and Powell, Abigail},
  date         = {2011},
  journaltitle = {Work, employment and society},
  title        = {Non-standard work schedules, work-family balance and the gendered division of childcare},
  issn         = {0950-0170},
  language     = {eng},
  number       = {2},
  pages        = {274-291},
  volume       = {25},
  abstract     = {What effect do non-standard work schedules have on how parents of young children can meet the combined and growing demands of work and family? This article uses the Australian Bureau of Statistics Time Use Survey 2006 to explore the relationship between parents' non-standard work hours, and the time they and their spouse spend in paid work, housework, childcare (subdivided into routine tasks and talk-based interaction) and in their children's company. Parents who work non-standard hours spend significantly longer in paid work and less time on housework and childcare than those who work standard hours. Spouses' schedules impact much more on mothers' than on fathers' time. When fathers work non-standard hours, mothers do more housework and routine childcare, so the gendered division of household labour intensifies. Mothers' non-standard hours allow them to schedule their own paid work and family responsibilities around each other, with little effect upon fathers' unpaid work.},
  copyright    = {Copyright © BSA Publications Ltd [2011]},
  keywords     = {Arbeitszeit ; Australia ; Australien ; Beruf ; Business & Economics ; Child care ; Child Care Services ; childcare ; Children ; Division of labor ; Doppelbelastung ; Economics ; Employment ; Erwerbstätigkeit ; Familie ; Familienleben ; Families & family life ; Family ; Family Work Relationship ; Fathers ; gender division of labour ; Geschlecht ; Housework ; Industrial Relations & Labor ; Kinderbetreuung ; Men ; Mothers ; non-standard work schedules ; Parent-child relations ; Parents ; Parents & parenting ; Sex factors ; Social Sciences ; Sociological analysis ; Sociology ; Spouses ; Time ; Time use ; Unpaid ; Women ; Work life balance ; Work schedules ; work-family balance ; Work-life balance: article ; Working conditions ; Working Hours ; Working mothers ; Working time ; Zeitallokation},
  location     = {London, England},
  publisher    = {SAGE Publications},
}

@Article{Craig2011a,
  author       = {Craig, Lyn and Mullan, Killian},
  date         = {2011},
  journaltitle = {American sociological review},
  title        = {How mothers and fathers share childcare: A cross-national time-use comparison},
  issn         = {0003-1224},
  language     = {eng},
  number       = {6},
  pages        = {834-861},
  volume       = {76},
  abstract     = {"In most families today, childcare remains divided unequally between fathers and mothers. Scholars argue that persistence of the gendered division of childcare is due to multiple causes, including values about gender and family, disparities in paid work, class, and social context. It is likely that all of these factors interact, but to date researchers have not explored such interactions. To address this gap, we analyze nationally representative time-use data from Australia, Denmark, France, and Italy. These countries have different employment patterns, social and family policies, and cultural attitudes toward parenting and gender equality. Using data from matched married couples, we conduct a cross-national study of mothers' and fathers' relative time in childcare, divided along dimensions of task (i.e., routine versus non-routine activities) and co-presence (i.e., caring for children together as a couple versus caring solo). Results show that mothers' and fathers' work arrangements and education relate modestly to shares of childcare, and this relationship differs across countries. We find cross-national variation in whether more equal shares result from the behavior of mothers, fathers, or both spouses. Results illustrate the relevance of social context in accentuating or minimizing the impact of individual- and household-level characteristics." (Author's abstract, IAB-Doku). Die Untersuchung enthält quantitative Daten. Forschungsmethode: empirisch; Querschnitt. Die Untersuchung bezieht sich auf den Zeitraum 1999 bis 2008.},
  copyright    = {Copyright ©2011 American Sociological Association},
  keywords     = {Analysis ; Arbeitsteilung ; Attitudes ; Australia ; Australien ; Beruf ; Child care ; Child Care Services ; Child. Socialization ; Childrearing Practices ; Children ; Children & youth ; Comparative analysis ; Couples ; Cross-national analysis ; cross-national comparison ; Cultural attitudes ; Denmark ; Division of labour ; Dänemark ; Education ; Employment ; Equality ; Erwerbstätiger ; Erwerbstätigkeit ; Familie ; Families & family life ; Family ; Family policy ; Family work relationship ; Fathers ; fathers' childcare ; France ; Frankreich ; Frau ; Gender ; Gender differentiation ; Gender equality ; Gender equity ; Gender inequality ; Geschlechtsspezifik ; Households ; Ideology ; Institution ; Interaction ; Internationaler Vergleich ; Italien ; Italy ; Kinderbetreuung ; Labor market ; Married couples ; Men ; Mothers ; mothers' childcare ; Mutter ; Parent-child relations ; Parenting ; Parents ; Parents & parenting ; Relatives ; Routine activities ; Sex ; Sexual division of labor ; Sexuality. Marriage. Family relations ; shares of childcare ; Social Environment ; Social policy ; Social Sciences ; Sociology ; Sociology of the family. Age groups ; Sozialer Faktor ; Spouses ; Studies ; Time ; Time management ; Time use ; Values ; Vater ; Woman social status. Women's emancipation ; Women ; Work organization ; Working mothers ; Zeitverwendung},
  location     = {Los Angeles, CA},
  publisher    = {Sage Publications},
}

@Article{Craig2017,
  author       = {Craig, Lyn and Brown, Judith E.},
  date         = {2017},
  journaltitle = {Journal of marriage and family},
  title        = {Feeling Rushed: Gendered Time Quality, Work Hours, Nonstandard Work Schedules, and Spousal Crossover},
  issn         = {0022-2445},
  language     = {eng},
  number       = {1},
  pages        = {225-242},
  volume       = {79},
  abstract     = {The authors investigated gender differences in couple parents' subjective time pressure, using detailed Australian time use data (n=756 couples with minor children). They examined how family demand, employment hours, and non-standard work schedules of both partners relate to each spouse's non-employment time quality ("pure" leisure, "contaminated" leisure, multitasking housework, and child care) and subjective feelings of being rushed or pressed for time. Mothers averaged more contaminated leisure and less pure leisure and did much more unpaid work multitasking than fathers. These results suggest that these differences in time quality do partially account for mothers feeling more rushed than fathers. Weekend work was associated with mothers having less pure leisure, but not contaminated leisure. The opposite was found for fathers. Spousal work characteristics also related to time use and feeling rushed in gendered ways, with male long work hours positively associated with higher time pressure for mothers as well as the fathers who worked them.},
  copyright    = {Copyright 2017 National Council on Family Relations},
  keywords     = {Australian Bureau of Statistics. Time Use Survey ; Child care ; Child care services ; Children ; Children & youth ; Couples ; Division of labour ; Effects ; Employees ; Employment ; Families & family life ; families and work ; family interaction ; Fathers ; Gender differences ; Households ; Housework ; housework/division of labor ; Job characteristics ; Leisure ; Mens health ; Mothers ; Multitasking ; Neoliberalism ; Parents & parenting ; Pressure ; Quality ; Quality of care ; Sex differences ; Spouses ; Stress ; Surveys ; Time ; Time use ; Unpaid work in the home ; Women ; Work and Family ; work hours ; Working hours ; Working mothers ; Working parents ; Workloads},
  location     = {Hoboken, USA},
  publisher    = {The National Council on Family Relations},
}

@Article{Craig2006,
  author       = {Craig, Lyn},
  date         = {2006},
  journaltitle = {Gender & society},
  title        = {Does Father Care Mean Fathers Share? A Comparison of How Mothers and Fathers in Intact Families Spend Time with Children},
  issn         = {0891-2432},
  language     = {eng},
  number       = {2},
  pages        = {259-281},
  volume       = {20},
  abstract     = {This article uses diary data from the most recent Australian Bureau of Statistics Time Use Survey (N > 4,000) to compare by gender total child care time calculated in the measurements of (1) main activity, (2) main or secondary activity, and (3) total time spent in the company of children. It also offers an innovative gender comparison of relative time spent in (1) the activities that constitute child care, (2) child care as double activity, and (3) time with children in sole charge. These measures give a fuller picture of total time commitment to children and how men and women spend that time than has been available in previous time use analyses. The results indicate that compared to fathering, mothering involves not only more overall time commitment but more multitasking, more physical labor, a more rigid timetable, more time alone with children, and more overall responsibility for managing care. These gender differences in the quantity and nature of care apply even when women work full-time.},
  copyright    = {Copyright 2006 Sociologists for Women in Society},
  keywords     = {Australia ; Care of children ; Child care ; Child rearing ; Childrearing Practices ; Children ; Children & youth ; Comparative analysis ; Comparative studies ; Demography ; Families & family life ; Family Roles ; Fathers ; Full-time employment ; Gender ; Gender differences ; Gender roles ; Gender studies ; Men ; Mothers ; Parenthood ; Parenting ; Parents ; Parents & parenting ; Research Reports ; Sex Roles ; Shared parenting ; Social Sciences ; Sociology ; Time use ; Women's Studies ; Workforce ; Working mothers ; Working women},
  location     = {Thousand Oaks, CA},
  publisher    = {Sage Publications},
}

@Article{Chandola2019,
  author       = {Chandola, Tarani and Booker, Cara L and Kumari, Meena and Benzeval, Michaela},
  date         = {2019},
  journaltitle = {Sociology (Oxford)},
  title        = {Are Flexible Work Arrangements Associated with Lower Levels of Chronic Stress-Related Biomarkers? A Study of 6025 Employees in the UK Household Longitudinal Study},
  issn         = {0038-0385},
  language     = {eng},
  number       = {4},
  pages        = {779-799},
  volume       = {53},
  abstract     = {Debates around the benefits of flexible work arrangements for employee well-being are limited by a lack of empirical analyses on whether flexible working enables employees with work or family stressors to cope with their levels of stress. This study examines whether the availability and use of different flexible work arrangements are associated with lower allostatic load (an index of chronic stress-related biomarkers) in a large representative study of UK adults. Male and female employees who made use of reduced hours working arrangements had lower levels of allostatic load. Among women caring for two or more children aged under 15, there was a difference of almost one unit of the allostatic load index (an additional biomarker risk) between women who used reduced hours flexible work and those without such arrangements. Reduced hours flexible work arrangements could enable women who combine work and family roles to reduce their levels of chronic stress.},
  copyright    = {The Author(s) 2019},
  keywords     = {allostatic load ; Arrangements ; Biological markers ; Biomarkers ; biosocial research ; Child care ; childcare ; Employees ; Family roles ; flexible work arrangements ; Occupational roles ; Occupational stress ; Sex roles ; Stress ; Well being ; Women ; Work ; Working hours ; Working women},
  location     = {London, England},
  publisher    = {Sage Publications, Ltd},
}

@Article{Carlson2016,
  author       = {Carlson, Daniel L. and Hanson, Sarah and Fitzroy, Andrea},
  date         = {2016},
  journaltitle = {Gender & Society},
  title        = {The Division of Child Care, Sexual Intimacy, and Relationship Quality in Couples},
  issn         = {0891-2432},
  language     = {eng},
  number       = {3},
  pages        = {442-466},
  volume       = {30},
  abstract     = {Increasingly, both mothers and fathers are expected to play an equal role in child rearing. Nonetheless, we know little about how child care arrangements affect couples' sexual intimacy and relationship quality. Research has focused on the effect of the division of paid labor and housework on couples' relationships, finding that egalitarianism is problematic for sexual intimacy, relationship quality, and relationship stability. These findings, however, come almost universally from studies utilizing decades-old data that fail to examine the division of child care. In this study, we update this work by utilizing data from the 2006 Marital and Relationship Study (N = 974) to examine how the division of child care affects the relationship quality and sexual intimacy of heterosexual couples in the United States. Results indicate that men's performance of child care is generally associated with more satisfaction with the division of child care, more satisfying sexual relationships, and higher quality relationships. Importantly, we find that egalitarian child care arrangements have positive consequences for both men and women. These findings contribute to a growing body of research that challenges the costs of egalitarianism and indicates instead that egalitarianism is associated with higher quality, more intimate relationships than gender traditional arrangements.},
  copyright    = {Copyright © 2016 Sociologists for Women in Society},
  keywords     = {Analysis ; Child care ; Child care services ; Children ; Couples ; Division of labor ; Egalitarianism ; gender egalitarian ; Gender equality ; Heterosexuality ; Housekeeping ; Housework ; Interpersonal relations ; Intimacy ; Management ; Men ; Mothers ; Parent child relations ; parenting ; Parents ; Quality ; Quality of health care ; relationship quality ; Satisfaction ; Sex ; Sexual behavior ; Sexual intercourse ; sexual intimacy ; Social Sciences ; Sociology ; Women ; Women's Studies},
  location     = {Los Angeles, CA},
  publisher    = {SAGE Publications},
}

@Article{Chung2018a,
  author       = {Chung, Heejung},
  date         = {2018},
  journaltitle = {Social policy & administration},
  title        = {Dualization and the access to occupational family-friendly working-time arrangements across Europe},
  issn         = {0144-5596},
  language     = {eng},
  number       = {2},
  pages        = {491-507},
  volume       = {52},
  abstract     = {This article examines outsiders' relative access to occupational level family‐friendly policies. I use data from the European Working Conditions Survey of 2015 across 30 European countries examining workers' access to two types of family‐friendly working‐time arrangements (WTAs): flexitime, and time off work for personal reasons. The article focuses on women with care responsibilities given that their demands for family‐friendly policies, as well as their outcomes, have been shown to be distinct from the rest of the working population. In addition to the outsider definition used in the labor market dualization and occupational segmentation literature, i.e., low‐skilled workers and those without a permanent contract, this article also defines outsiders as those perceiving their job as insecure. The results of the analysis show a segmentation between workers in their access to family‐friendly policies. Unlike statutory policies, occupational policies seem to be selectively provided mostly to workers where employers have a vested interest, i.e., insiders, resulting in a dualized system for most countries. However, rather than their contract status, the skill‐level of the job/workers, and their perceived insecurity were found to be important. The results further show that although Northern European and some continental European countries are those where family‐friendly WTAs are more readily available, it is in these countries where the division between insiders and outsiders is the greatest. The results of the article contribute to the literature by showing a need to move beyond the national level when examining family‐friendly policies, and to examine a more diverse definition of outsiders when examining dualization of working conditions.},
  copyright    = {2018 The Authors Social Policy & Administration Published by John Wiley & Sons Ltd},
  keywords     = {Arbeitsbedingungen ; Arbeitsplatzsicherheit ; Arbeitszeitflexibilität ; Befristeter Arbeitsvertrag ; Belgien ; Beruf ; Bulgarien ; Deutschland ; dualization ; Dänemark ; Employers ; Estland ; Europäische Union ; Familie ; Families & family life ; Family ; Family work relationship ; Females ; Finnland ; Flexitime ; Frankreich ; Freistellung ; Griechenland ; Großbritannien ; Irland ; Italien ; Job insecurity ; Kroatien ; Labor market ; Labor supply ; Lettland ; Litauen ; Luxemburg ; Malta ; Mutter ; Niederlande ; Norwegen ; occupational family-friendly policies ; Polen ; Portugal ; Qualifikation ; Rumänien ; Schweden ; Schweiz ; Security ; Segmentation ; skill-level ; Skilled labor ; Skilled workers ; Slowakei ; Slowenien ; Soziale Ungleichheit ; Spanien ; subjective insecurity ; temporary employment ; Tschechische Republik ; Unbefristeter Arbeitsvertrag ; Ungarn ; Women ; Work environment ; Workers ; Working conditions ; Working women ; working-time arrangements ; Zypern ; Österreich},
  location     = {Oxford},
  publisher    = {Wiley Subscription Services, Inc},
}

